# ==============================================================================
# FRESHCART PRODUCTION ENVIRONMENT SPECIFICATION (.env)
# Simply replace the placeholder keys below with your actual credentials.
# The application runs crash-free in high-fidelity mock/sandbox mode until keys are added.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & DATABASE
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET=your-secure-random-jwt-secret-string-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-secure-random-refresh-secret-string-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Local MongoDB or MongoDB Atlas Replica Set URI
MONGODB_URI=mongodb://127.0.0.1:27017/shop
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shop?retryWrites=true&w=majority

# Redis Cache & Concurrency Lock (Optional - defaults to high-speed in-memory engine if empty)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=rediss://default:<password>@<elasticache-endpoint>:6379

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (Financial Core)
# Get keys from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 3. AMAZON WEB SERVICES (S3 Media Storage & CloudFront CDN)
# Get keys from: AWS IAM Console -> Users -> Security Credentials
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=freshcart-production-media-assets
# Optional CloudFront CDN Domain:
# CLOUDFRONT_URL=https://d123456abcdef8.cloudfront.net

# ------------------------------------------------------------------------------
# 4. STORE BUSINESS RULES & TAX (Indian GST)
# ------------------------------------------------------------------------------
STORE_STATE=Maharashtra
STORE_PINCODE=400001
MAX_COD_AMOUNT=10000

# ------------------------------------------------------------------------------
# 5. IN-HOUSE DELIVERY FLEET (Default Logistics Engine)
# No third-party courier credentials needed!
# ------------------------------------------------------------------------------
FLEET_NAME=FreshCart Express Fleet
WAREHOUSE_ADDRESS=Central Fulfillment Hub, Sector 4, Ghaziabad, UP - 201014
SUPPORT_PHONE=1800-FRESH-CART
